{
	"env": {
		"commonjs": true,
		"es2022": true,
		"node": true
	},
	"parserOptions": {
		"ecmaVersion": 2022,
		"sourceType": "module"
	},
	"rules": {
		"no-const-assign": "error",
		"no-undef": "error",
		"no-unreachable": "error",
		"no-unused-vars": ["warn", {"argsIgnorePattern": "^_"}],
		"valid-typeof": "error",
		"eqeqeq": "warn",
		"no-var": "error",
		"prefer-const": "warn"
	}
}
